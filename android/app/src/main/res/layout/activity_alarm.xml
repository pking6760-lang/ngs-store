<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#0E1430"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:paddingTop="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

    <!-- Incoming pill -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_alarm_pill"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="● INCOMING ORDER"
        android:textColor="#9DB2FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.14" />

    <!-- Glowing avatar -->
    <FrameLayout
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_marginTop="30dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_alarm_glow" />

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_alarm_ring"
            android:gravity="center"
            android:text="🔔"
            android:textSize="50sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="New delivery!"
        android:textColor="#F4F4F6"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text=""
        android:textColor="#9BA6CC"
        android:textSize="17sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Accept (single action) -->
    <Button
        android:id="@+id/btn_accept"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/bg_accept_btn"
        android:text="Accept order"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/app_name"
        android:textColor="#46508A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

</LinearLayout>
